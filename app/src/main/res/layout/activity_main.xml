<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2FB94"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Cabeçalho -->
        <RelativeLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="#F2FB94">

            <ImageButton
                android:id="@+id/btnToolbox"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_alignParentStart="true"
                android:background="@drawable/bg_toolbox_button"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_puzzle1" />

            <ImageView
                android:id="@+id/logo"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_centerInParent="true"
                android:src="@drawable/ziblocks"
                android:adjustViewBounds="true" />

        </RelativeLayout>

        <!-- Blockly -->
        <WebView
            android:id="@+id/webview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

    <!-- Imagem da splash sobre o aplicativo -->
    <ImageView
        android:id="@+id/splashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F2FB94"
        android:src="@drawable/splash_ziblocks"
        android:scaleType="fitCenter"
        android:contentDescription="@string/app_name" />

</FrameLayout>
